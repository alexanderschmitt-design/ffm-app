# Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# HMAC secret for signing the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-32-byte-hex-string

# Per-booth admin password. Set one variable per booth slug, uppercased,
# with non-alphanumeric chars replaced by underscores.
# Example: a booth with slug "tax" uses BOOTH_PASSWORD_TAX, slug "rd-team"
# uses BOOTH_PASSWORD_RD_TEAM.
BOOTH_PASSWORD_TAX=change-me

# Legacy: ADMIN_PASSWORD still works as the password for the "tax" booth
# (so the original single-booth deploy keeps working without re-setting
# env vars on Vercel). For any new booth use BOOTH_PASSWORD_<SLUG>.
# ADMIN_PASSWORD=change-me
